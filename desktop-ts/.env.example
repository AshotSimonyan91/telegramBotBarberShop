# Скопируйте в .env (файл не коммитится) или задайте переменные окружения.
# Значения из окружения важнее настроек, сохранённых в приложении.

# Адрес HTTP API бота (без /api/v1)
SALON_API_URL=http://127.0.0.1:8787
# Токен API (Authorization: Bearer ...). Тот же, что задан на стороне бота.
SALON_API_TOKEN=
