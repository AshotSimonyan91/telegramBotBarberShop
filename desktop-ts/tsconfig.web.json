{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/src/*"],
      "@mocks/*": ["src/mocks/*"]
    }
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/mocks/**/*", "src/preload/*.d.ts"]
}
